# App
APP_ENV=development
APP_PORT=8080

# Database
DATABASE_URL=postgres://zawaj:zawaj@localhost:5432/zawaj?sslmode=disable

# JWT (generate strong random values for non-dev; never commit real secrets)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Auth hardening
PIN_MAX_ATTEMPTS=5
PIN_LOCKOUT=15m
