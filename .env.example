# App
APP_ENV=development
APP_PORT=8080

# Database (production must use sslmode=require or stronger)
DATABASE_URL=postgres://zawaj:zawaj@localhost:5432/zawaj?sslmode=disable
# Connection pool
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=1h

# Any secret below can instead be read from a file via <NAME>_FILE (Docker/K8s
# secrets), e.g. JWT_ACCESS_SECRET_FILE=/run/secrets/jwt_access. The _FILE form
# takes precedence. In production, JWT secrets must be >= 32 bytes, distinct, and
# not placeholder values.

# JWT (generate strong random values for non-dev; never commit real secrets)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Auth hardening (login lockout)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT=15m

# CORS: comma-separated exact origins allowed for browser cross-origin requests.
# Dev defaults to "*"; production REQUIRES explicit origins (a "*" is rejected).
# CORS_ALLOWED_ORIGINS=https://app.zawaj.example,https://admin.zawaj.example

# Rate limiting (per client IP token bucket). RATE_LIMIT_RPS=0 disables it.
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40

# Push (FCM). Point at a Firebase service-account JSON to enable real delivery;
# unset = no-op sender (notifications still stored in-app). The JSON's project_id
# selects the Firebase project.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-sa.json

# Swagger UI is served at /swagger/index.html in non-production. In production it
# is off unless you opt in:
# ENABLE_SWAGGER=true
